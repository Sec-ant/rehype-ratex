{
  "name": "@sec-ant/rehype-ratex",
  "version": "0.1.1",
  "description": "rehype plugin to render math with RaTeX (KaTeX-compatible, Rust/WASM)",
  "private": false,
  "type": "module",
  "packageManager": "pnpm@10.34.5+sha512.a4ee05f2f73658255bd6a89859c065a45c28a57daefae2c893a168ee2b73168c37b91e83e57ea67654ad03f03031746430e8bce38e362e042605fb8abc80192e",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/rehype-ratex.js"
    }
  },
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Sec-ant/rehype-ratex.git"
  },
  "homepage": "https://github.com/Sec-ant/rehype-ratex",
  "bugs": {
    "url": "https://github.com/Sec-ant/rehype-ratex/issues"
  },
  "keywords": [
    "hast",
    "html",
    "ratex",
    "katex",
    "latex",
    "markdown",
    "math",
    "plugin",
    "rehype",
    "rehype-plugin",
    "remark",
    "tex",
    "unified",
    "wasm",
    "rust"
  ],
  "author": {
    "name": "Ze-Zheng Wu"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "update-hooks": "simple-git-hooks",
    "lint": "biome lint .",
    "type-check": "tsc --noEmit --emitDeclarationOnly false",
    "check": "biome check --write .",
    "format": "biome format --write .",
    "clear:dist": "rimraf dist",
    "prebuild": "pnpm -s check && pnpm -s type-check && pnpm -s clear:dist",
    "build": "vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "dev": "vite dev -c demo/vite.config.ts --open",
    "demo:build": "vite build -c demo/vite.config.ts",
    "prepublishOnly": "pnpm -s build"
  },
  "dependencies": {
    "@types/hast": "^3.0.0",
    "hast-util-from-html-isomorphic": "^2.0.0",
    "hast-util-to-text": "^4.0.0",
    "ratex-wasm": "^0.1.0",
    "unist-util-visit-parents": "^6.0.0",
    "vfile": "^6.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.11",
    "@changesets/cli": "^2.30.0",
    "@commitlint/cli": "^20.5.0",
    "@commitlint/config-conventional": "^20.5.0",
    "@types/node": "^24.12.2",
    "@vitest/ui": "4.1.4",
    "lint-staged": "^16.4.0",
    "rehype-parse": "^9.0.0",
    "rehype-stringify": "^10.0.0",
    "remark-math": "^6.0.0",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.0.0",
    "rimraf": "^6.1.3",
    "simple-git-hooks": "^2.13.1",
    "typescript": "^6.0.2",
    "unified": "^11.0.0",
    "vite": "^8.0.8",
    "vite-plugin-dts": "^4.5.4",
    "vitest": "^4.1.4"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "simple-git-hooks"
    ]
  }
}
